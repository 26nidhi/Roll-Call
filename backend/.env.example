# Copy this file to .env and fill in your own values before running the server

# Postgres connection string. If running Postgres locally with the provided
# docker-compose.yml, this default value will work as-is.
DATABASE_URL=postgres://attendance_user:attendance_pass@localhost:5432/attendance

# Secret used to sign JWTs — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Port the backend server runs on
PORT=4000

# How often the QR token rotates, in seconds
TOKEN_ROTATE_SECONDS=6

# How long a single QR token stays valid after being generated, in seconds
# (kept equal to or slightly above TOKEN_ROTATE_SECONDS so there's no gap)
TOKEN_VALID_SECONDS=8

# How many minutes after a session starts that check-ins are still accepted
SESSION_CHECKIN_WINDOW_MINUTES=10

# Max euclidean distance between a live face descriptor and the registered
# one for it to be considered a match. Lower = stricter. 0.5-0.6 is typical
# for face-api.js's 128-point descriptors.
FACE_MATCH_THRESHOLD=0.5
