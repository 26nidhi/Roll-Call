# Copy this to .env.test before running `npm test`.
# Deliberately a SEPARATE database from your real .env — the test suite
# truncates all tables between tests, so pointing this at your real
# classroom database would wipe real attendance data.
#
# Uses the same host/port as .env.example by default — if you changed the
# port in docker-compose.yml (e.g. to 5433 to avoid a conflict with a
# locally-installed Postgres), use that same port here too.

DATABASE_URL=postgres://attendance_user:attendance_pass@localhost:5432/attendance_test
